def cmd_install(profile: str = "audiophile") -> None:
    print(f"{C_CYAN}{C_BOLD}Installing SteelSeries 7 PipeWire & WirePlumber configurations...{C_RESET}")
    CONFIG_DIR_PIPEWIRE.mkdir(parents=True, exist_ok=True)
    CONFIG_DIR_WIREPLUMBER.mkdir(parents=True, exist_ok=True)

    WP_CONF_PATH.write_text(generate_wp_conf())
    print(f"  {C_GREEN}✓ Written:{C_RESET} {WP_CONF_PATH}")

    DSP_CONF_PATH.write_text(generate_dsp_conf(profile))
    print(f"  {C_GREEN}✓ Written:{C_RESET} {DSP_CONF_PATH} (Profile: {profile})")

    cmd_restart()
    cmd_sbc_xq()

    phys_id, _, _, dsp_id, _ = get_sinks()
    if dsp_id:
        cmd_set_default("dsp")
    print(f"{C_GREEN}{C_BOLD}Installation complete and active!{C_RESET}")


def cmd_restart() -> None:
    print(f"{C_CYAN}Restarting PipeWire & WirePlumber services...{C_RESET}")
    run_cmd(["systemctl", "--user", "restart", "pipewire", "wireplumber"])

    for _ in range(20):
        time.sleep(0.25)
        _, _, _, dsp_id, _ = get_sinks()
        if dsp_id:
            print(f"{C_GREEN}✓ Services restarted and DSP graph confirmed.{C_RESET}")
            return
    print(f"{C_YELLOW}⚠ Services restarted, but DSP graph took too long to resolve.{C_RESET}")


def cmd_profile(profile_name: str) -> None:
        profile_name = profile_name.lower()
        if profile_name not in PRESETS:
            print(f"{C_RED}Error: Unknown profile '{profile_name}'.{C_RESET}")
            sys.exit(1)

        print(f"{C_CYAN}Switching DSP Profile to: {C_BOLD}{profile_name.capitalize()}{C_RESET}")
        DSP_CONF_PATH.parent.mkdir(parents=True, exist_ok=True)
        DSP_CONF_PATH.write_text(generate_dsp_conf(profile_name))

        # Run a clean userspace service restart
        run_cmd(["systemctl", "--user", "restart", "pipewire", "wireplumber"])

        # Poll the graph for up to 5 seconds to let the virtual node initialize
        dsp_id = None
        for _ in range(20):
            time.sleep(0.25)
            _, _, _, found_dsp_id, _ = get_sinks()
            if found_dsp_id:
                dsp_id = found_dsp_id
                break

        if dsp_id:
            # Enforce WirePlumber default sink routing natively
            run_cmd(["wpctl", "set-default", str(dsp_id)])
            print(f"  {C_GREEN}✓ Native system target locked back onto Pro DSP [Node: {dsp_id}]{C_RESET}")
        else:
            print(f"  {C_YELLOW}⚠ Profile written, but virtual sink took too long to re-index.{C_RESET}")

        print(f"{C_GREEN}✓ Profile '{profile_name}' applied: {PRESETS[profile_name]['description']}{C_RESET}")



def cmd_sbc_xq() -> None:
    print(f"{C_CYAN}Enforcing SBC-XQ High-Bitpool Bluetooth profile...{C_RESET}")
    card_name = None

    # Smart polling loop to handle BlueZ reconnection latency
    for attempt in range(12):
        ret, cards_out, _ = run_cmd(["pactl", "list", "cards"])
        for block in cards_out.split("Card #"):
            if ("Arena 7" in block or "SteelSeries" in block) and "bluez_card" in block:
                match = re.search(r"Name:\s*(bluez_card\.[a-zA-Z0-9_]+)", block)
                if match:
                    card_name = match.group(1)
                    break
        if card_name:
            break
        time.sleep(0.5)

    if card_name:
        ret, _, err = run_cmd(["pactl", "set-card-profile", card_name, "a2dp-sink-sbc_xq"])
        if ret == 0:
            print(f"  {C_GREEN}✓ Successfully switched {card_name} to SBC-XQ!{C_RESET}")
        else:
            print(f"  {C_YELLOW}Notice: {err}{C_RESET}")
    else:
        print(f"  {C_YELLOW}Bluetooth card not detected after 6 seconds. Skipping BlueZ profile injection.{C_RESET}")


def cmd_set_default(target: str) -> None:
    phys_id, phys_name, conn_type, dsp_id, dsp_name = get_sinks()

    if target == "dsp":
        if not dsp_id:
            print(f"{C_RED}Error: DSP sink not found in PipeWire graph. Is it installed?{C_RESET}")
            sys.exit(1)

        target_id = dsp_id
        display = "SteelSeries Arena 7 (Pro DSP Virtual Node)"
    elif target == "direct":
        if not phys_id:
            print(f"{C_RED}Error: Physical Arena 7 ({conn_type}) not found in PipeWire graph.{C_RESET}")
            sys.exit(1)

        target_id = phys_id
        display = f"SteelSeries Arena 7 (Direct {conn_type})"
    else:
        print(f"{C_RED}Error: Target must be 'dsp' or 'direct'{C_RESET}")
        sys.exit(1)

    print(f"{C_CYAN}Routing default sink to: {C_BOLD}{display}{C_RESET} [Node: {target_id}]")
    ret, _, err = run_cmd(["wpctl", "set-default", str(target_id)])
    if ret == 0:
        print(f"  {C_GREEN}✓ Default sink locked natively via WirePlumber.{C_RESET}")
    else:
        print(f"  {C_RED}Error via wpctl: {err}{C_RESET}")


