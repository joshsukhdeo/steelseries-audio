    {{ name = libpipewire-module-filter-chain
        flags = [ ifexists, nofail ]
        args = {{
            node.description = "SteelSeries Arena 7 (Pro DSP - {profile_name.capitalize()})"
            media.name       = "SteelSeries Arena 7 DSP"
            filter.graph = {{
                nodes = [
                    {{ type = builtin, name = eq_l_sub, label = {sub["type"]}, control = {{ "Freq" = {sub["freq"]} "Q" = {sub["q"]} "Gain" = {sub["gain"]} }} }}
                    {{ type = builtin, name = eq_l_mud, label = {mud["type"]}, control = {{ "Freq" = {mud["freq"]} "Q" = {mud["q"]} "Gain" = {mud["gain"]} }} }}
                    {{ type = builtin, name = eq_l_vocal, label = {voc["type"]}, control = {{ "Freq" = {voc["freq"]} "Q" = {voc["q"]} "Gain" = {voc["gain"]} }} }}
                    {{ type = builtin, name = eq_l_air, label = {air["type"]}, control = {{ "Freq" = {air["freq"]} "Q" = {air["q"]} "Gain" = {air["gain"]} }} }}
                    {{ type = builtin, name = eq_r_sub, label = {sub["type"]}, control = {{ "Freq" = {sub["freq"]} "Q" = {sub["q"]} "Gain" = {sub["gain"]} }} }}
                    {{ type = builtin, name = eq_r_mud, label = {mud["type"]}, control = {{ "Freq" = {mud["freq"]} "Q" = {mud["q"]} "Gain" = {mud["gain"]} }} }}
                    {{ type = builtin, name = eq_r_vocal, label = {voc["type"]}, control = {{ "Freq" = {voc["freq"]} "Q" = {voc["q"]} "Gain" = {voc["gain"]} }} }}
                    {{ type = builtin, name = eq_r_air, label = {air["type"]}, control = {{ "Freq" = {air["freq"]} "Q" = {air["q"]} "Gain" = {air["gain"]} }} }}
                ]
                links = [
                    {{ output = "eq_l_sub:Out", input = "eq_l_mud:In" }}
                    {{ output = "eq_l_mud:Out", input = "eq_l_vocal:In" }}
                    {{ output = "eq_l_vocal:Out", input = "eq_l_air:In" }}
                    {{ output = "eq_r_sub:Out", input = "eq_r_mud:In" }}
                    {{ output = "eq_r_mud:Out", input = "eq_r_vocal:In" }}
                    {{ output = "eq_r_vocal:Out", input = "eq_r_air:In" }}
                ]
                inputs  = [ "eq_l_sub:In" "eq_r_sub:In" ]
                outputs = [ "eq_l_air:Out" "eq_r_air:Out" ]
            }}
            audio.channels = 2
            audio.position = [ FL FR ]
            capture.props = {{
                node.name        = "{DSP_SINK_NAME}"
                node.description = "SteelSeries Arena 7 (Pro DSP - {profile_name.capitalize()})"
                media.class      = "Audio/Sink"
                priority.driver  = 1600
                priority.session = 1600
            }}
            playback.props = {{
                node.name         = "{DSP_SINK_NAME}_output"
                node.passive      = true
                node.autoconnect  = true
            }}
        }}
    }}
]
"""


def generate_wp_conf() -> str:
    return """# WirePlumber configuration for SteelSeries Arena 7 / Series 7
# Enables SBC-XQ High-Bitpool codec for BT, sets speaker form factor universally

monitor.bluez.properties = {
  bluez5.enable-sbc-xq = true
  bluez5.enable-msbc = true
  bluez5.codecs = [ sbc_xq aac ldac aptx aptx_hd sbc ]
}

device.profile.priority.rules = [
  {
    matches = [ { device.name = "~bluez_card.*" } ]
    actions = { update-props = { priorities = [ "a2dp-sink-sbc_xq", "a2dp-sink-ldac", "a2dp-sink-aptx_hd", "a2dp-sink" ] } }
  }
]

monitor.bluez.rules = [
  {
    matches = [
      { device.name = "~bluez_card.*", device.alias = "~.*Arena 7.*" },
      { device.name = "~bluez_card.*", device.description = "~.*Arena 7.*" }
    ]
    actions = {
      update-props = {
        device.form-factor = "speaker"
        device.icon_name = "audio-speakers"
        bluez5.auto-connect = [ a2dp_sink ]
        bluez5.profile = "a2dp-sink-sbc_xq"
      }
    }
  },
  {
    matches = [ { node.name = "~bluez_output.*", node.description = "~.*Arena 7.*" } ]
    actions = {
      update-props = {
        node.description = "SteelSeries Arena 7 (SBC-XQ)"
        priority.driver = 1500
        priority.session = 1500
        session.suspend-timeout-seconds = 0
      }
    }
  }
]
"""


def cmd_install(profile: str = "audiophile") -> None:
    print(f"{C_CYAN}{C_BOLD}Installing SteelSeries 7 PipeWire & WirePlumber configurations...{C_RESET}")
    CONFIG_DIR_PIPEWIRE.mkdir(parents=True, exist_ok=True)
    CONFIG_DIR_WIREPLUMBER.mkdir(parents=True, exist_ok=True)

    WP_CONF_PATH.write_text(generate_wp_conf())
    print(f"  {C_GREEN}✓ Written:{C_RESET} {WP_CONF_PATH}")

    DSP_CONF_PATH.write_text(generate_dsp_conf(profile))
    print(f"  {C_GREEN}✓ Written:{C_RESET} {DSP_CONF_PATH} (Profile: {profile})")

    cmd_restart()
    cmd_sbc_xq()
    
    phys_id, _, _, dsp_id, _ = get_sinks()
    if dsp_id:
        cmd_set_default("dsp")
    print(f"{C_GREEN}{C_BOLD}Installation complete and active!{C_RESET}")


def cmd_restart() -> None:
    print(f"{C_CYAN}Restarting PipeWire & WirePlumber services...{C_RESET}")
    run_cmd(["systemctl", "--user", "restart", "pipewire", "wireplumber"])
    
    # Poll graph up to 5 seconds to prevent race conditions during DSP routing
    for _ in range(20):
        time.sleep(0.25)
        _, _, _, dsp_id, _ = get_sinks()
        if dsp_id:
            print(f"{C_GREEN}✓ Services restarted and DSP graph confirmed.{C_RESET}")
            return
    print(f"{C_YELLOW}⚠ Services restarted, but DSP graph took too long to resolve.{C_RESET}")


def cmd_profile(profile_name: str) -> None:
    profile_name = profile_name.lower()
    if profile_name not in PRESETS:
        print(f"{C_RED}Error: Unknown profile '{profile_name}'.{C_RESET}")
        sys.exit(1)

    print(f"{C_CYAN}Switching DSP Profile to: {C_BOLD}{profile_name.capitalize()}{C_RESET}")
    DSP_CONF_PATH.parent.mkdir(parents=True, exist_ok=True)
    DSP_CONF_PATH.write_text(generate_dsp_conf(profile_name))
    run_cmd(["systemctl", "--user", "restart", "pipewire"])
    time.sleep(0.5)
    print(f"{C_GREEN}✓ Profile '{profile_name}' applied: {PRESETS[profile_name]['description']}{C_RESET}")


def cmd_sbc_xq() -> None:
    print(f"{C_CYAN}Enforcing SBC-XQ High-Bitpool Bluetooth profile...{C_RESET}")
    ret, cards_out, _ = run_cmd(["pactl", "list", "cards"])
    card_name = None
    for block in cards_out.split("Card #"):
        if "Arena 7" in block and "bluez_card" in block:
            match = re.search(r"Name:\s*(bluez_card\.[a-zA-Z0-9_]+)", block)
            if match:
                card_name = match.group(1)
                break

    if card_name:
        ret, _, err = run_cmd(["pactl", "set-card-profile", card_name, "a2dp-sink-sbc_xq"])
        if ret == 0:
            print(f"  {C_GREEN}✓ Successfully switched {card_name} to SBC-XQ!{C_RESET}")
        else:
            print(f"  {C_YELLOW}Notice: {err}{C_RESET}")
    else:
        print(f"  {C_YELLOW}Bluetooth card not detected. Skipping BlueZ profile injection.{C_RESET}")


def cmd_set_default(target: str) -> None:
    phys_id, phys_name, conn_type, dsp_id, dsp_name = get_sinks()

    if target == "dsp":
        if not dsp_id:
            print(f"{C_RED}Error: DSP sink not found in PipeWire graph. Is it installed?{C_RESET}")
            sys.exit(1)
            
        target_id = dsp_id
        display = "SteelSeries Arena 7 (Pro DSP Virtual Node)"
    elif target == "direct":
        if not phys_id:
            print(f"{C_RED}Error: Physical Arena 7 ({conn_type}) not found in PipeWire graph.{C_RESET}")
            sys.exit(1)
            
        target_id = phys_id
        display = f"SteelSeries Arena 7 (Direct {conn_type})"
    else:
        print(f"{C_RED}Error: Target must be 'dsp' or 'direct'{C_RESET}")
        sys.exit(1)

    print(f"{C_CYAN}Routing default sink to: {C_BOLD}{display}{C_RESET} [Node: {target_id}]")
    ret, _, err = run_cmd(["wpctl", "set-default", str(target_id)])
    if ret == 0:
        print(f"  {C_GREEN}✓ Default sink locked natively via WirePlumber.{C_RESET}")
    else:
        print(f"  {C_RED}Error via wpctl: {err}{C_RESET}")


def cmd_test() -> None:
    print(f"{C_CYAN}{C_BOLD}Running SteelSeries 7 Audio Diagnostics & Channel Test...{C_RESET}")
    print(f"  1. Testing Left Satellite Speaker...")
    run_cmd(["speaker-test", "-t", "sine", "-f", "440", "-c", "2", "-s", "1", "-l", "1", "-P", "2"])
    print(f"  2. Testing Right Satellite Speaker...")
    run_cmd(["speaker-test", "-t", "sine", "-f", "440", "-c", "2", "-s", "2", "-l", "1", "-P", "2"])
    print(f"  3. Testing 6.5\" Subwoofer Low-Frequency Resonance (55 Hz)...")
    run_cmd(["speaker-test", "-t", "sine", "-f", "55", "-c", "2", "-l", "1", "-P", "2"])
    print(f"{C_GREEN}{C_BOLD}✓ Channel test complete.{C_RESET}")


def cmd_status() -> None:
    print(f"{C_CYAN}{C_BOLD}=== SteelSeries 7 Audio Status ==={C_RESET}")
    phys_id, phys_name, conn_type, dsp_id, dsp_name = get_sinks()

    if conn_type == "None":
        print(f"  Connection:       {C_RED}○ Disconnected (Neither USB nor BT found){C_RESET}")
    else:
        print(f"  Connection:       {C_GREEN}● Active ({conn_type}){C_RESET} [Node: {phys_id}]")

    if conn_type == "Bluetooth":
        _, cards_out, _ = run_cmd(["pactl", "list", "cards"])
        active_profile = "unknown"
        for block in cards_out.split("Card #"):
            if "Arena 7" in block and "bluez_card" in block:
                match = re.search(r"Active Profile:\s*([^\n]+)", block)
                if match:
                    active_profile = match.group(1).strip()
                break

        if "sbc_xq" in active_profile:
            codec_display = f"{C_GREEN}{C_BOLD}SBC-XQ (Dual-Channel High-Bitpool){C_RESET}"
        else:
            codec_display = f"{C_YELLOW}{active_profile}{C_RESET}"
        print(f"  Active BT Codec:  {codec_display}")
    elif conn_type == "USB":
        print(f"  Active DAC:       {C_GREEN}{C_BOLD}PCM Direct ALSA (USB Lossless){C_RESET}")

    cur_prof = get_current_profile_name()
    desc = PRESETS.get(cur_prof, {}).get("description", "Custom curve")
    print(f"  Active DSP Preset:{C_MAGENTA}{C_BOLD} {cur_prof.capitalize()}{C_RESET} ({desc})")

    _, info_out, _ = run_cmd(["wpctl", "status"])
    def_sink = "Unknown"
    for line in info_out.split("\n"):
        if "*" in line and "Audio" not in line and "Video" not in line and "Sink" not in line:
            if str(dsp_id) in line:
                def_sink = f"{C_GREEN}{C_BOLD}SteelSeries Pro DSP Sink (Active){C_RESET}"
            elif str(phys_id) in line:
                def_sink = f"{C_CYAN}Direct {conn_type} Sink{C_RESET}"
            break

    print(f"  System Default:   {def_sink}")
    print(f"=================================")


def main() -> None:
    parser = argparse.ArgumentParser(
        description="SteelSeries 7 (Arena 7) PipeWire Audio Suite",
        formatter_class=argparse.RawDescriptionHelpFormatter
    )
    subparsers = parser.add_subparsers(dest="command")

    subparsers.add_parser("status")
    subparsers.add_parser("install")
    subparsers.add_parser("restart")
    subparsers.add_parser("sbc-xq")
    subparsers.add_parser("test")

    prof_parser = subparsers.add_parser("profile")
    prof_parser.add_argument("name", choices=list(PRESETS.keys()))

    def_parser = subparsers.add_parser("set-default")
    def_parser.add_argument("target", choices=["dsp", "direct"])

    args = parser.parse_args()

    if args.command == "status" or not args.command:
        cmd_status()
    elif args.command == "install":
        cmd_install()
    elif args.command == "restart":
        cmd_restart()
    elif args.command == "sbc-xq":
        cmd_sbc_xq()
    elif args.command == "profile":
        cmd_profile(args.name)
    elif args.command == "set-default":
        cmd_set_default(args.target)
    elif args.command == "test":
        cmd_test()


if __name__ == "__main__":
    main()
