def cmd_install(profile: str = "audiophile") -> None:
    print(f"{C_CYAN}{C_BOLD}Installing SteelSeries 7 PipeWire & WirePlumber configurations...{C_RESET}")
    CONFIG_DIR_PIPEWIRE.mkdir(parents=True, exist_ok=True)
    CONFIG_DIR_WIREPLUMBER.mkdir(parents=True, exist_ok=True)

    # Remove old broken/legacy filter-chain if present
    legacy_conf = CONFIG_DIR_PIPEWIRE / "2.1-lfe.conf"
    if legacy_conf.exists():
        legacy_conf.unlink()
        print(f"  {C_YELLOW}Removed obsolete 2.1-lfe.conf{C_RESET}")

    # Write WirePlumber configuration
    WP_CONF_PATH.write_text(generate_wp_conf())
    print(f"  {C_GREEN}✓ Written:{C_RESET} {WP_CONF_PATH}")

    # Write PipeWire DSP configuration
    DSP_CONF_PATH.write_text(generate_dsp_conf(profile))
    print(f"  {C_GREEN}✓ Written:{C_RESET} {DSP_CONF_PATH} (Profile: {profile})")

    # Restart PipeWire & WirePlumber
    cmd_restart()
    cmd_sbc_xq()
    cmd_set_default("dsp")
    print(f"{C_GREEN}{C_BOLD}Installation complete and active!{C_RESET}")


def cmd_restart() -> None:
    print(f"{C_CYAN}Restarting PipeWire & WirePlumber services...{C_RESET}")
    run_cmd(["systemctl", "--user", "restart", "pipewire", "wireplumber"])
    run_cmd(["sleep", "1"])
    print(f"{C_GREEN}✓ Services restarted successfully.{C_RESET}")


def cmd_profile(profile_name: str) -> None:
    profile_name = profile_name.lower()
    if profile_name not in PRESETS:
        print(f"{C_RED}Error: Unknown profile '{profile_name}'.{C_RESET}")
        print(f"Available profiles: {', '.join(PRESETS.keys())}")
        sys.exit(1)

    print(f"{C_CYAN}Switching DSP Profile to: {C_BOLD}{profile_name.capitalize()}{C_RESET}")
    DSP_CONF_PATH.parent.mkdir(parents=True, exist_ok=True)
    DSP_CONF_PATH.write_text(generate_dsp_conf(profile_name))
    run_cmd(["systemctl", "--user", "restart", "pipewire"])
    run_cmd(["sleep", "0.5"])
    print(f"{C_GREEN}✓ Profile '{profile_name}' applied: {PRESETS[profile_name]['description']}{C_RESET}")


def cmd_sbc_xq() -> None:
    print(f"{C_CYAN}Enforcing SBC-XQ High-Bitpool Bluetooth profile...{C_RESET}")
    _, cards_out, _ = run_cmd(["pactl", "list", "cards"])
    card_match = re.search(r"Name:\s*(bluez_card\.[a-zA-Z0-9_]+)", cards_out)
    if card_match:
        card_name = card_match.group(1)
        ret, _, err = run_cmd(["pactl", "set-card-profile", card_name, "a2dp-sink-sbc_xq"])
        if ret == 0:
            print(f"  {C_GREEN}✓ Successfully switched {card_name} to SBC-XQ!{C_RESET}")
            return
        else:
            print(f"  {C_YELLOW}Notice: {err}{C_RESET}")
    else:
        print(f"  {C_YELLOW}Bluetooth device not connected right now.{C_RESET}")


def cmd_set_default(target: str) -> None:
    if target == "dsp":
        sink_name = DSP_SINK_NAME
        display_name = "SteelSeries Arena 7 (Pro DSP)"
    elif target == "direct":
        sink_name = f"bluez_output.{STEELSERIES_MAC.replace(':', '_')}.1"
        display_name = "SteelSeries Arena 7 (Direct SBC-XQ)"
    else:
        sink_name = target
        display_name = target

    print(f"{C_CYAN}Setting default sink to: {C_BOLD}{display_name}{C_RESET}")
    ret, _, err = run_cmd(["pactl", "set-default-sink", sink_name])
    if ret == 0:
        print(f"  {C_GREEN}✓ Default sink set to {sink_name}{C_RESET}")
    else:
        print(f"  {C_YELLOW}Notice: {err}{C_RESET}")


def cmd_test() -> None:
    print(f"{C_CYAN}{C_BOLD}Running SteelSeries 7 Audio Diagnostics & Channel Test...{C_RESET}")
    print(f"  1. Testing Left Satellite Speaker...")
    run_cmd(["speaker-test", "-t", "sine", "-f", "440", "-c", "2", "-s", "1", "-l", "1", "-P", "2"])
    print(f"  2. Testing Right Satellite Speaker...")
    run_cmd(["speaker-test", "-t", "sine", "-f", "440", "-c", "2", "-s", "2", "-l", "1", "-P", "2"])
    print(f"  3. Testing 6.5\" Subwoofer Low-Frequency Resonance (55 Hz)...")
    run_cmd(["speaker-test", "-t", "sine", "-f", "55", "-c", "2", "-l", "1", "-P", "2"])
    print(f"{C_GREEN}{C_BOLD}✓ Channel test complete.{C_RESET}")


def cmd_status() -> None:
    print(f"{C_CYAN}{C_BOLD}=== SteelSeries 7 Audio Status ==={C_RESET}")

    # Bluetooth device check
    _, bt_info, _ = run_cmd(["bluetoothctl", "info", STEELSERIES_MAC])
    is_connected = "Connected: yes" in bt_info

    if is_connected:
        print(f"  Bluetooth Status:   {C_GREEN}● Connected{C_RESET} ({STEELSERIES_MAC})")
    else:
        print(f"  Bluetooth Status:   {C_RED}○ Disconnected{C_RESET} ({STEELSERIES_MAC})")

    # Card & Codec check
    _, cards_out, _ = run_cmd(["pactl", "list", "cards"])
    card_name = f"bluez_card.{STEELSERIES_MAC.replace(':', '_')}"
    active_profile = "unknown"

    if card_name in cards_out:
        card_blocks = cards_out.split("Card #")
        for block in card_blocks:
            if card_name in block:
                match = re.search(r"Active Profile:\s*([^\n]+)", block)
                if match:
                    active_profile = match.group(1).strip()
                break

    if "sbc_xq" in active_profile:
        codec_display = f"{C_GREEN}{C_BOLD}SBC-XQ (Dual-Channel High-Bitpool ~551 kbps){C_RESET}"
    elif "sbc" in active_profile:
        codec_display = f"{C_YELLOW}SBC Standard (Low Bitpool){C_RESET}"
    else:
        codec_display = active_profile

    print(f"  Active BT Codec:    {codec_display}")

    # DSP Profile
    cur_prof = get_current_profile_name()
    desc = PRESETS.get(cur_prof, {}).get("description", "Custom curve")
    print(f"  Active DSP Preset:  {C_MAGENTA}{C_BOLD}{cur_prof.capitalize()}{C_RESET} ({desc})")

    # Default sink check
    _, info_out, _ = run_cmd(["pactl", "info"])
    match_sink = re.search(r"Default Sink:\s*([^\n]+)", info_out)
    def_sink = match_sink.group(1).strip() if match_sink else "unknown"

    if def_sink == DSP_SINK_NAME:
        print(f"  System Default:     {C_GREEN}{C_BOLD}SteelSeries Pro DSP Sink (Active){C_RESET}")
    elif "bluez_output" in def_sink:
        print(f"  System Default:     {C_CYAN}Direct Bluetooth Sink{C_RESET}")
    else:
        print(f"  System Default:     {C_YELLOW}{def_sink}{C_RESET}")

    # Volume check
    _, sinks_out, _ = run_cmd(["pactl", "list", "sinks"])
    sink_blocks = sinks_out.split("Sink #")
    for block in sink_blocks:
        if DSP_SINK_NAME in block or f"bluez_output.{STEELSERIES_MAC.replace(':', '_')}" in block:
            match_vol = re.search(r"Volume:[^\n]+/\s*([0-9]+%)[^\n]+Mute:\s*([a-z]+)", block)
            if match_vol:
                vol = match_vol.group(1)
                muted = match_vol.group(2)
                s_name = "DSP Sink" if DSP_SINK_NAME in block else "Direct BT Sink"
                print(f"  {s_name} Volume:     {vol} (Muted: {muted})")

    print(f"=================================")


def main() -> None:
    parser = argparse.ArgumentParser(
        description="SteelSeries 7 (Arena 7) PipeWire & Bluetooth Audio Suite",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Profiles:
  audiophile   High-fidelity balanced curve (deep punchy sub, clear vocals, silk highs)
  gaming       Tactical curve (amplified footsteps, spatial clarity, punchy explosions)
  cinema       Movie curve (maximum sub excursion, clear dialogue, wide soundstage)
  bass-boost   Maximum sub-bass slam for EDM / Bass-heavy genres
  voice        Podcast / Communication clarity curve
  flat         Neutral transparent reference curve
        """,
    )
    subparsers = parser.add_subparsers(dest="command", help="Command to run")

    subparsers.add_parser("status", help="Show connection, codec, and DSP status")
    subparsers.add_parser("install", help="Install & configure PipeWire & WirePlumber optimizations")
    subparsers.add_parser("restart", help="Restart PipeWire and WirePlumber services")
    subparsers.add_parser("sbc-xq", help="Force SBC-XQ High-Bitpool codec mode")
    subparsers.add_parser("test", help="Run channel & subwoofer sweep diagnostic test")

    prof_parser = subparsers.add_parser("profile", help="Switch DSP acoustic profile")
    prof_parser.add_argument("name", choices=list(PRESETS.keys()), help="Profile name")

    def_parser = subparsers.add_parser("set-default", help="Set default audio sink")
    def_parser.add_argument("target", choices=["dsp", "direct"], help="Target sink ('dsp' or 'direct')")

    args = parser.parse_args()

    if args.command == "status" or not args.command:
        cmd_status()
    elif args.command == "install":
        cmd_install()
    elif args.command == "restart":
        cmd_restart()
    elif args.command == "sbc-xq":
        cmd_sbc_xq()
    elif args.command == "profile":
        cmd_profile(args.name)
    elif args.command == "set-default":
        cmd_set_default(args.target)
    elif args.command == "test":
        cmd_test()


if __name__ == "__main__":
    main()
