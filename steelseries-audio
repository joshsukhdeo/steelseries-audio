def cmd_status(device_name: str="SteelSeries Arena 7") -> None:
    print(f"{C_CYAN}{C_BOLD}=== {device_name} Audio Status ==={C_RESET}")
    phys_id, phys_name, conn_type, dsp_id, dsp_name = get_sinks(device_name)

    if conn_type == "None":
        print(f"  Connection:       {C_RED}○ Disconnected (Neither USB nor BT found){C_RESET}")
    else:
        print(f"  Connection:       {C_GREEN}● Active ({conn_type}){C_RESET} [Node: {phys_id}]")

    if conn_type == "Bluetooth":
        _, cards_out, _ = run_cmd(["pactl", "list", "cards"])
        active_profile = "unknown"
        for block in cards_out.split("Card #"):
            if (device_name.lower() in block.lower()) and "bluez_card" in block:
                match = re.search(r"Active Profile:\s*([^\n]+)", block)
                if match:
                    active_profile = match.group(1).strip()
                break

        if "sbc_xq" in active_profile:
            codec_display = f"{C_GREEN}{C_BOLD}SBC-XQ (Dual-Channel High-Bitpool){C_RESET}"
        else:
            codec_display = f"{C_YELLOW}{active_profile}{C_RESET}"
        print(f"  Active BT Codec:  {codec_display}")
    elif conn_type == "USB":
        print(f"  Active DAC:       {C_GREEN}{C_BOLD}PCM Direct ALSA (USB Lossless){C_RESET}")

    cur_prof = get_current_profile_name()
    desc = PRESETS.get(cur_prof, {}).get("description", "Custom curve")
    print(f"  Active DSP Preset:{C_MAGENTA}{C_BOLD} {cur_prof.capitalize()}{C_RESET} ({desc})")

    _, inspect_out, _ = run_cmd(["wpctl", "inspect", "@DEFAULT_AUDIO_SINK@"])
    id_match = re.search(r"id\s+(\d+)", inspect_out)
    def_sink = "Unknown"

    if id_match:
        active_id = int(id_match.group(1))
        if dsp_id and active_id == dsp_id:
            def_sink = f"{C_GREEN}{C_BOLD}SteelSeries Pro DSP Sink (Active){C_RESET}"
        elif phys_id and active_id == phys_id:
            def_sink = f"{C_CYAN}Direct {conn_type} Sink{C_RESET}"
        else:
            def_sink = f"{C_YELLOW}Other Device [Node: {active_id}]{C_RESET}"

    print(f"  System Default:   {def_sink}")
    print(f"=================================")


def main() -> None:
    check_dependencies()

    parser = argparse.ArgumentParser(
        description="SteelSeries 7 (Arena 7) PipeWire Audio Suite",
        formatter_class=argparse.RawDescriptionHelpFormatter
    )
    base_parser = argparse.ArgumentParser(add_help=False)
    base_parser.add_argument("-d", "--device", default="SteelSeries Arena 7", help="Target device name (default: SteelSeries Arena 7)")
    
    subparsers = parser.add_subparsers(dest="command")

    subparsers.add_parser("status", parents=[base_parser])
    subparsers.add_parser("install", parents=[base_parser])
    subparsers.add_parser("restart", parents=[base_parser])
    subparsers.add_parser("sbc-xq", parents=[base_parser])
    subparsers.add_parser("test", parents=[base_parser])
    subparsers.add_parser("completions", parents=[base_parser])

    prof_parser = subparsers.add_parser("profile", parents=[base_parser])
    prof_parser.add_argument("name", choices=list(PRESETS.keys()))

    def_parser = subparsers.add_parser("set-default", parents=[base_parser])
    def_parser.add_argument("target", choices=["dsp", "direct"])

    try:
        import argcomplete
        argcomplete.autocomplete(parser)
    except ImportError:
        pass

    args = parser.parse_args()

    if args.command == "status" or not args.command:
        cmd_status(args.device)
    elif args.command == "install":
        cmd_install("audiophile", args.device)
    elif args.command == "restart":
        cmd_restart(args.device)
    elif args.command == "sbc-xq":
        cmd_sbc_xq(args.device)
    elif args.command == "profile":
        cmd_profile(args.name, args.device)
    elif args.command == "set-default":
        cmd_set_default(args.target, args.device)
    elif args.command == "test":
        cmd_test()
    elif args.command == "completions":
        cmd_completions()


if __name__ == "__main__":
    main()
