def check_dependencies() -> None:
    missing = []
    required_cmds = ["wpctl", "pw-dump", "pactl", "bluetoothctl", "speaker-test"]
    for cmd in required_cmds:
        if shutil.which(cmd) is None:
            missing.append(cmd)

    if missing:
        print(f"{C_RED}Error: Missing required CLI tools: {', '.join(missing)}{C_RESET}")
        print(f"{C_YELLOW}Arch Linux:{C_RESET} sudo pacman -S wireplumber pipewire-pulse bluez-utils alsa-utils")
        print(f"{C_YELLOW}Ubuntu:{C_RESET} sudo apt install wireplumber pipewire-pulse bluez alsa-utils")
        sys.exit(1)


def run_cmd(cmd: List[str], check: bool = False) -> Tuple[int, str, str]:
    res = subprocess.run(cmd, capture_output=True, text=True)
    if check and res.returncode != 0:
        raise RuntimeError(f"Command {' '.join(cmd)} failed: {res.stderr.strip()}")
    return res.returncode, res.stdout.strip(), res.stderr.strip()


def get_pw_nodes():
    ret, out, err = run_cmd(["pw-dump"])
    if ret != 0:
        return []
    try:
        return json.loads(out)
    except:
        return []


def get_sinks(device_name="SteelSeries Arena 7"):
    nodes = get_pw_nodes()
    physical_id, physical_name, connection_type = None, None, "None"
    dsp_id, dsp_name = None, None

    for n in nodes:
        if n.get("type") == "PipeWire:Interface:Node":
            info = n.get("info", {})
            props = info.get("props", {})
            name = props.get("node.name", "")
            desc = props.get("node.description", "")
            node_id = info.get("id", n.get("id"))

            if name == DSP_SINK_NAME:
                dsp_id = node_id
                dsp_name = name
            elif device_name.lower() in desc.lower() or device_name.replace(" ", "_").lower() in name.lower():
                if name.startswith("alsa_output"):
                    physical_id = node_id
                    physical_name = name
                    connection_type = "USB"
                elif name.startswith("bluez_output"):
                    physical_id = node_id
                    physical_name = name
                    connection_type = "Bluetooth"

    return physical_id, physical_name, connection_type, dsp_id, dsp_name


def get_current_profile_name() -> str:
    if not DSP_CONF_PATH.exists():
        return "none (uninstalled)"
    content = DSP_CONF_PATH.read_text()
    match = re.search(r"# Profile:\s*([a-zA-Z0-9_-]+)", content)
    return match.group(1) if match else "custom/audiophile"


