  }},
  {{
    matches = [
        {{ node.name = "~bluez_output.*", node.description = "~.*{device_name}.*" }}
    ]
    actions = {{
      update-props = {{
        node.description = "{device_name} (Optimized)"
        priority.driver = 1500
        priority.session = 1500
        session.suspend-timeout-seconds = 0{latency_rules}
      }}
    }}
  }}
]
