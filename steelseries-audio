    {{ name = libpipewire-module-filter-chain
        flags = [ ifexists, nofail ]
        args = {{
            node.description = "SteelSeries Arena 7 (Pro DSP - {profile_name.capitalize()})"
            media.name       = "SteelSeries Arena 7 DSP"
            filter.graph = {{
                nodes = [
                    # Left Channel Filters
                    {{
                        type  = builtin
                        name  = eq_l_sub
                        label = {sub["type"]}
                        control = {{ "Freq" = {sub["freq"]} "Q" = {sub["q"]} "Gain" = {sub["gain"]} }}
                    }}
                    {{
                        type  = builtin
                        name  = eq_l_mud
                        label = {mud["type"]}
                        control = {{ "Freq" = {mud["freq"]} "Q" = {mud["q"]} "Gain" = {mud["gain"]} }}
                    }}
                    {{
                        type  = builtin
                        name  = eq_l_vocal
                        label = {voc["type"]}
                        control = {{ "Freq" = {voc["freq"]} "Q" = {voc["q"]} "Gain" = {voc["gain"]} }}
                    }}
                    {{
                        type  = builtin
                        name  = eq_l_air
                        label = {air["type"]}
                        control = {{ "Freq" = {air["freq"]} "Q" = {air["q"]} "Gain" = {air["gain"]} }}
                    }}

                    # Right Channel Filters
                    {{
