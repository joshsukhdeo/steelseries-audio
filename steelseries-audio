def cmd_completions() -> None:
    print(f"{C_CYAN}Installing native Bash & Zsh completions...{C_RESET}")

    profiles_str = " ".join(PRESETS.keys())

    # ---------------- BASH COMPLETION ----------------
    bash_script = f"""_steelseries_audio_complete() {{
    local cur prev
    cur="${{COMP_WORDS[COMP_CWORD]}}"
    prev="${{COMP_WORDS[COMP_CWORD-1]}}"

    if [[ ${{COMP_CWORD}} -eq 1 ]]; then
        COMPREPLY=( $(compgen -W "status install restart sbc-xq test profile set-default completions" -- "${{cur}}") )
        return 0
    fi

    case "${{prev}}" in
        profile)
            COMPREPLY=( $(compgen -W "{profiles_str}" -- "${{cur}}") )
            return 0
            ;;
        set-default)
            COMPREPLY=( $(compgen -W "dsp direct" -- "${{cur}}") )
            return 0
            ;;
        -d|--device)
            return 0
            ;;
    esac

