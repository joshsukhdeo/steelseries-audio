                    }}
                    {{
                        type  = builtin
                        name  = eq_r_mud
                        label = {mud["type"]}
                        control = {{ "Freq" = {mud["freq"]} "Q" = {mud["q"]} "Gain" = {mud["gain"]} }}
                    }}
                    {{
                        type  = builtin
