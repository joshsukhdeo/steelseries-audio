def generate_wp_conf(device_name: str="SteelSeries Arena 7") -> str:
    latency_rules = ""
    if device_name == "SteelSeries Arena 7":
        latency_rules = """
        node.force-quantum = 4096
        node.latency = "4096/48000"""

    return f"""# WirePlumber configuration for {device_name}

monitor.bluez.properties = {{
  bluez5.enable-sbc-xq = true
  bluez5.enable-msbc = true
  bluez5.codecs = [ sbc_xq aac ldac aptx aptx_hd sbc ]
}}

monitor.bluez.rules = [
  {{
    matches = [
      {{ device.name = "~bluez_card.*", device.alias = "~.*{device_name}.*" }},
      {{ device.name = "~bluez_card.*", device.description = "~.*{device_name}.*" }}
    ]
    actions = {{
      update-props = {{
        device.form-factor = "headset"
        device.icon_name = "audio-headset"
